{
  "name": "iobroker.open-smart-city-home",
  "version": "0.0.1",
  "description": "Binder for OSCH",
  "author": {
    "name": "fpac",
    "email": "fpachmann@nedeco.de"
  },
  "contributors": [],
  "homepage": "https://github.com/fpac/ioBroker.open-smart-city-home",
  "license": "MIT",
  "keywords": [
    "template",
    "automation",
    "IoT",
    "integration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fpac/ioBroker.open-smart-city-home.git"
  },
  "engines": {
    "node": ">= 20"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.3.2"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.0.0",
    "@alcalzone/release-script-plugin-iobroker": "^4.0.0",
    "@alcalzone/release-script-plugin-license": "^4.0.0",
    "@alcalzone/release-script-plugin-manual-review": "^4.0.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.2.0",
    "@iobroker/testing": "^5.2.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/iobroker": "npm:@iobroker/types@^7.1.0",
    "@types/node": "^24.10.11",
    "rimraf": "^6.1.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "qs": "6.14.1",
    "tough-cookie": "6.0.0",
    "form-data": "4.0.5",
    "diff": "8.0.3",
    "esbuild": "0.27.2",
    "xmldom": "npm:@xmldom/xmldom@0.9.8"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "build-adapter ts",
    "watch": "build-adapter ts --watch",
    "prebuild:ts": "rimraf build",
    "build:ts": "build-adapter ts",
    "watch:ts": "build-adapter ts --watch",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "check": "tsc --noEmit",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script",
    "dev-server": "dev-server"
  },
  "bugs": {
    "url": "https://github.com/fpac/ioBroker.open-smart-city-home/issues"
  },
  "readmeFilename": "README.md"
}